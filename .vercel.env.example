# Base de Données (Obligatoire)
# L'URL de connexion PostgreSQL (Neon, Heroku, Supabase, etc.)
DATABASE_URL="postgres://user:password@host:port/database?sslmode=require"

# Sécurité & Sessions (Obligatoire)
# Une longue chaîne de caractères aléatoire pour signer les sessions
SESSION_SECRET="votre_secret_de_session_tres_long_et_securise"

# Administration (Optionnel, Valeurs par défaut si vide : admin@gstore.local / Admin1234!)
ADMIN_EMAIL="votre_email_admin"
ADMIN_PASSWORD="votre_mot_de_passe_admin_securise"

# OAuth Discord (Optionnel, requis pour la connexion Discord)
DISCORD_CLIENT_ID="votre_discord_client_id"
DISCORD_CLIENT_SECRET="votre_discord_client_secret"
# L'URL de callback doit correspondre à celle sur le portail dev Discord (ex: https://votre-site.vercel.app/auth/discord/callback)
DISCORD_REDIRECT_URI="https://votre-site.vercel.app/auth/discord/callback"

# OAuth Steam (Optionnel, requis pour la connexion Steam)
STEAM_API_KEY="votre_cle_api_steam"
STEAM_REALM="https://votre-site.vercel.app"
STEAM_RETURN_URL="https://votre-site.vercel.app/auth/steam/callback"

# Paiement Stripe (Optionnel, requis pour les paiements en ligne)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."

# Divers
APP_BASE_URL="https://votre-site.vercel.app"